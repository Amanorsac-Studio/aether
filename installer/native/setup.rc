#include <windows.h>

1 PAYLOAD "payload.zip"   /* staged next to this .rc by CMake */

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Amanorsac Studio"
            VALUE "FileDescription",  "AETHER Setup"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AetherSetup"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Amanorsac Studio"
            VALUE "OriginalFilename", "AETHER_Setup.exe"
            VALUE "ProductName",      "AETHER - Dynamic Air Exciter"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "setup.manifest"
